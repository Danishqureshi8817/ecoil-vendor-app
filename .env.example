# Local dev — NestJS backend on port 3000 (mirrors dashboard VITE_API_ORIGIN)
API_ORIGIN=http://localhost:3000

# Physical Android device on Wi‑Fi: use your computer's LAN IP instead of localhost
# API_ORIGIN=http://192.168.1.42:3000

# Production build (__DEV__ false) defaults to https://vendor-api.ecoil.in when unset
# API_ORIGIN=https://vendor-api.ecoil.in
