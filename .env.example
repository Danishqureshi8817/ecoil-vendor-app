# API URLs are configured in source — no .env file required.
#
# Edit:
#   src/config/apiBase.ts
#     CONFIG_API_ORIGIN              — e.g. https://vendor-api.ecoil.in
#     CONFIG_SERVICE_ICON_BASE_URL   — optional; empty = {API_ORIGIN}/api/file-upload
#
# Local backend example:
#   CONFIG_API_ORIGIN = 'http://localhost:3000'
#   (Android emulator auto-remaps localhost → 10.0.2.2)
#
# Physical device on Wi‑Fi — use your computer LAN IP:
#   CONFIG_API_ORIGIN = 'http://192.168.1.42:3000'
